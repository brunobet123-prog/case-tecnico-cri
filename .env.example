# Projeto do Supabase > Settings > API
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key

# Chave da IA fica no servidor de desenvolvimento, não no browser.
# Sem esta chave, a interface usa um gerador local personalizado.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
